# Backend Configuration
PORT=4820
BASE_URL=http://localhost:4820
DB_PATH=./data/shortener.db
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:4810,http://localhost:4800,http://127.0.0.1:4810
# Exact domains and their subdomains, comma separated (example: blocked.example)
BLOCKED_LINK_DOMAINS=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4820
VITE_SITE_URL=https://links.avari.dev

# Web Analytics (Optional)
# Yandex.Metrika Counter ID (e.g. 98765432)
VITE_YM_COUNTER_ID=
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# Enable Yandex Metrika Webvisor (true / false)
VITE_YM_WEBVISOR=true
